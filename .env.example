# ── Minecraft 連線 ──
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=ECHO
MC_VERSION=1.21.1
MC_AUTH=offline

# 指揮官（機器人跟隨、丟物品、逃跑的對象）
MASTER_NAME=your_minecraft_name

# 測試旁路帳號（以逗號分隔）。這些帳號發 "TARS_TEST: 動作 參數" 可跳過大腦直接執行
TESTER_NAMES=ECHO_Tester,TARS_Tester

# ── Agent API（讓外部大腦接入）──
AGENT_HOST=127.0.0.1
AGENT_PORT=5070
# 留空 = 不驗證（僅限綁在 127.0.0.1 時使用）。設定後請求需帶 Authorization: Bearer <token>
AGENT_TOKEN=

# 設為 1：把每個動作與結果記錄到 logs/trajectory-*.jsonl
TRAJECTORY_LOG=0

# ── 參考大腦（階段 B 使用，OpenAI-compatible 端點）──
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=
